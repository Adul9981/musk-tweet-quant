# RapidAPI credentials for Twitter Scraper API
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=xscraper.p.rapidapi.com

# First-party anonymous analytics (private Vercel environment variables)
STATS_GIST_ID=your_private_gist_id
GITHUB_TOKEN=your_github_token_with_gist_scope
ANALYTICS_ADMIN_TOKEN=replace_with_a_long_random_admin_token
ANALYTICS_IP_SALT=replace_with_a_long_random_private_salt
